# BookVerse Environment Variables

PORT=5000
MONGODB_URI=mongodb://localhost:27017/bookverse
JWT_SECRET=bookverse_hackathon_super_secret_key_2026

# Firebase Authentication (Optional - default fallback auth enabled)
FIREBASE_PROJECT_ID=bookverse-demo
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps API Key (Optional - interactive custom SVG map fallback enabled)
GOOGLE_MAPS_API_KEY=

# AI Recommendation API Key (Optional - local recommendation algorithm enabled)
AI_API_KEY=

# n8n Automation Webhook URL (Optional - local workflow dispatcher enabled)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/bookverse-events
